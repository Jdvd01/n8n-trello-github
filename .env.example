# Railway injects PORT automatically.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_HOST=your-n8n-domain.up.railway.app
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-n8n-domain.up.railway.app/

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${PGHOST}
DB_POSTGRESDB_PORT=${PGPORT}
DB_POSTGRESDB_DATABASE=${PGDATABASE}
DB_POSTGRESDB_USER=${PGUSER}
DB_POSTGRESDB_PASSWORD=${PGPASSWORD}

GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=your-repository
GITHUB_TOKEN=replace-with-a-github-token